/ {
	cpuapp_tcm: memory@20020000 {
		#address-cells = < 0x1 >;
		#size-cells = < 0x1 >;
		compatible = "zephyr,memory-region";
		reg = < 0x20020000 0xf000 >;
		#memory-region-cells = < 0x0 >;
		zephyr,memory-region = "MYTCM";
		zephyr,memory-attr = < 0x0 >;
	};
};

&cpuapp_sram {
	reg = < 0x20000000 0x20000 >;
	ranges = < 0x0 0x20000000 0x20000 >;
};
