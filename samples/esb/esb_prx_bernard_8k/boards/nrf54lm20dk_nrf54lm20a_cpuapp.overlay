/ {
	hid_dev_0: hid_dev_0 {
		compatible = "zephyr,hid-device";
		label = "HID0";
		protocol-code = "none";
		in-polling-period-us = <125>;
		in-report-size = <64>;
	};

	cpuapp_tcm: memory@20040000 {
		#address-cells = < 0x1 >;
		#size-cells = < 0x1 >;
		compatible = "zephyr,memory-region";
		reg = < 0x20040000 0xf000 >;
		#memory-region-cells = < 0x0 >;
		zephyr,memory-region = "MYTCM";
		zephyr,memory-attr = < 0x0 >;
	};
};

&cpuapp_sram {
	reg = < 0x20000000 0x40000 >;
	ranges = < 0x0 0x20000000 0x40000 >;
};
