/delete-node/ &boot_partition;
/delete-node/ &slot0_partition;
/delete-node/ &slot1_partition;
/delete-node/ &storage_partition;
 / {	
	esb_gpio {
		compatible = "gpio-leds";
		esb_io_radio_disabled: esb-io-radio-disabled {
			gpios = <&gpio1 10 GPIO_ACTIVE_LOW>;
			label = "esb io radio disabled";
		};
		esb_io_radio_rx: esb-io-radio-rx {
			gpios = <&gpio1 11 GPIO_ACTIVE_LOW>;
			label = "esb io radio ready";
		};
		esb_io_radio_tx: esb-io-radio-tx {
			gpios = <&gpio1 12 GPIO_ACTIVE_LOW>;
			label = "esb io radio ready";
		};
	};
};
&cpuapp_rram {
	reg = <0x0 DT_SIZE_K(500)>;
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;
		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x0 0x10000>;
		};
		/* 
		slot0_partition: partition@10000 {
			label = "image-0";
			reg = <0x10000 0x160000>;
		};
		*/
		slot0_partition: partition@10000 {
			label = "image-0";
			reg = <0x10000 0x68000>;
		};
		
		/* 52k from 0x170000 to 0x17cfff reserved for TF-M partitions */
		/* 
		storage_partition: partition@170000 {
			label = "storage";
			reg = <0x170000 0x2000>;
		};
		*/
		storage_partition: partition@78000 {
			label = "storage";
			reg = <0x78000 0x2000>;
		};
	};
};

&pinctrl {
	spi00_default: spi00_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 2, 1)>,
				<NRF_PSEL(SPIM_MOSI, 2, 2)>,
				<NRF_PSEL(SPIM_MISO, 2, 4)>;
		};
	};

	spi00_sleep: spi00_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 2, 1)>,
				<NRF_PSEL(SPIM_MOSI, 2, 2)>,
				<NRF_PSEL(SPIM_MISO, 2, 4)>;
				low-power-enable;
		};
	};
};

&spi00 {
	// status = "okay";
	status = "disabled";
	cs-gpios = <&gpio2 5 GPIO_ACTIVE_LOW>;
	pinctrl-0 = <&spi00_default>;
	pinctrl-1 = <&spi00_sleep>;
	pinctrl-names = "default", "sleep";

	dut_spi00_dt: test-spi-dev@0 {
		compatible = "vnd,spi-device";
		reg = <0>;
		spi-max-frequency = <DT_FREQ_M(4)>;
	};

	mx25r64: mx25r6435f@0 {
		status = "disabled";
	};
};

&led0 {
	status = "disabled";
};

&led1 {
	status = "disabled";
};

&led2 {
	status = "disabled";
};

&led3 {
	status = "disabled";
};

&button0 {
	status = "disabled";
};

&button1 {
	status = "disabled";
};

&button2 {
	status = "disabled";
};

&button3 {
	status = "disabled";
};

&pwm20 {
	status = "disabled";
};

&pwm_led1 {
	status = "disabled";
};

&uart20 {
	// status = "disabled";
	current-speed = <921600>;
};
&uart20_default {
	group1 {
		psels = <NRF_PSEL(UART_TX, 1, 4)>;
	};
};

&uart20_sleep {
	group1 {
		psels = <NRF_PSEL(UART_TX, 1, 4)>;
	};
};
/delete-node/ &{/pin-controller/uart20_default/group2/};

&lfxo {
    status = "disabled";
};

